# Copy to .env and edit.  cp .env.example .env

# ---- Pick ONE provider -------------------------------------------------
# ollama        : local, free, offline (default)
# gemini        : Google free tier, no card. Key: https://aistudio.google.com
# openai_compat : any OpenAI-compatible API (Groq / OpenRouter free models, LM Studio)
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b          # 8 GB RAM: qwen3:4b · 16 GB+: qwen3:8b · GPU 24 GB: qwen3:30b
OLLAMA_THINK=off               # off | on | default

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_BASE_URL=               # e.g. https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- RAG embeddings ------------------------------------------------------
EMBEDDING_PROVIDER=ollama      # ollama | gemini
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Agent -----------------------------------------------------------------
REQUIRE_APPROVAL=true          # ask before run_python executes code
MAX_HISTORY_MESSAGES=40
RECURSION_LIMIT=30

# ---- Optional: tracing with LangSmith (free developer plan) -------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-starter
